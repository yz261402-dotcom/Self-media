# 视觉参考分析（画面分析）。只列本功能新增的变量；密钥沿用 AVATAR_STUDIO_QWEN_API_KEY，不在此处写。
AVATAR_STUDIO_CONTENT_VISUAL_PROVIDER=qwen
AVATAR_STUDIO_CONTENT_VISUAL_MODEL=qwen3-vl-plus
# 完整视觉响应等待上限（秒，30–1800）；不触发自动重发。
AVATAR_STUDIO_CONTENT_VISUAL_TIMEOUT_SECONDS=600
AVATAR_STUDIO_CONTENT_VISUAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 预留额（分）：发送前占用内容预算；用户确认的费用上限不得低于它
AVATAR_STUDIO_CONTENT_VISUAL_RESERVE_FEN=80
# 单次实际费用（分）。留空 = 单价未核验，费用保持“待对账”，不会记成 0 元
AVATAR_STUDIO_CONTENT_VISUAL_PRICE_FEN=
AVATAR_STUDIO_CONTENT_VISUAL_MAX_BYTES=209715200
AVATAR_STUDIO_CONTENT_VISUAL_MAX_DURATION_MS=600000
# 自动获取参考视频（RedFox 下载器）：预留额（分）与单价（分，留空=未核验、费用待对账）。密钥沿用 AVATAR_STUDIO_REDFOX_API_KEY
AVATAR_STUDIO_REDFOX_RESERVE_FEN_VIDEO_DOWNLOAD=50
AVATAR_STUDIO_REDFOX_PRICE_FEN_VIDEO_DOWNLOAD=

# PostgreSQL 业务库连接串（必填）
AVATAR_STUDIO_DATABASE_URL=postgresql://user:password@127.0.0.1:5432/avatar_studio

# 写稿执行方式：http_api 或 claude_code；默认 GPT-6.1 Sol 写稿/返工，GPT-6 Astra 策划/审核。
AVATAR_STUDIO_CONTENT_WRITER_EXECUTION_MODE=http_api
# 文本 HTTP 路径：direct 不读取 Windows/环境代理；system 保留原系统代理行为（代码默认）。
# 不会在断连后自动切换路径重发。切换路径会产生新的写稿运行身份。
AVATAR_STUDIO_CONTENT_HTTP_PROXY_MODE=direct
# 文本角色共用 OpenAI-compatible URL/key，模型由角色单独指定。
# AVATAR_STUDIO_CONTENT_WRITER_PROVIDER=openai
# AVATAR_STUDIO_CONTENT_WRITER_MODEL=gpt-6.1-sol
# AVATAR_STUDIO_CONTENT_WRITER_MAX_OUTPUT=16384
# AVATAR_STUDIO_CONTENT_WRITER_TIMEOUT_SECONDS=600
# Claude Code 模式默认等待600秒；密钥仍只从项目配置注入子进程环境。
# AVATAR_STUDIO_CLAUDE_CODE_EXECUTABLE=C:/path/to/claude.exe
# Claude Code 专用模式配置；仅 writer/repair 使用 Anthropic Claude Code 时启用。
# AVATAR_STUDIO_CLAUDE_CODE_CONTEXT_1M=true

# GPT 文本使用的凭据与 GPT Image 生图密钥分开；策划与审核共用 GPT-6 Astra。
# AVATAR_STUDIO_CONTENT_PLANNER_PROVIDER=openai
# AVATAR_STUDIO_CONTENT_PLANNER_MODEL=gpt-6-astra
# AVATAR_STUDIO_CONTENT_REVIEWER_PROVIDER=openai
# AVATAR_STUDIO_CONTENT_REVIEWER_MODEL=gpt-6-astra
# AVATAR_STUDIO_CONTENT_REVIEWER_EXECUTION_MODE=http_api
# AVATAR_STUDIO_CONTENT_REVIEWER_MAX_OUTPUT=16384
# AVATAR_STUDIO_CONTENT_REVIEWER_TIMEOUT_SECONDS=600
# 写稿后审核一次即展示结论；0 关闭自动返工，用户仍可定向返工。
AVATAR_STUDIO_CONTENT_MAX_REPAIR_ROUNDS=0
# 审核输出保持简洁；超时只终止等待，不自动重发未知付费请求。
AVATAR_STUDIO_CONTENT_REVIEWER_MAX_OUTPUT=4096
# AVATAR_STUDIO_OPENAI_BASE_URL=https://api.openai.com/v1
# AVATAR_STUDIO_OPENAI_API_KEY=填写本地密钥，不提交版本库
# AVATAR_STUDIO_CONTENT_GPT_REASONING_EFFORT=medium

# 可选的本地输入预算（tokens）。留空或设为 0 表示不启用统一上限，
# 由实际供应商/模型的上下文窗口负责拒绝超长请求；系统不会静默截断输入。
# AVATAR_STUDIO_CONTENT_MAX_INPUT_TOKENS=24000

# Wan 分镜不受全局预算上限阻断；仍保留用户确认与幂等台账
AVATAR_STUDIO_WAN_STORYBOARD_BUDGET_UNLIMITED=0
