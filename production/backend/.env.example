# 首次部署模板：复制为同目录 .env；真实配置不提交、不打包。
# .env 读取器支持 KEY=value 和整行注释；不要在值后添加行内注释。
# 密钥为空时不会通过这些供应商提交真实模型请求。

# 1. PostgreSQL：compose.yaml 使用 POSTGRES_*，后端使用连接串。
# 修改密码时同步修改下面的 POSTGRES_PASSWORD 和 DATABASE_URL。
# 首次可用随机 32 位十六进制密码，避免 URL 特殊字符编码问题。
POSTGRES_USER=avatar
POSTGRES_DB=avatar_studio
POSTGRES_PASSWORD=change_me_local_password
AVATAR_STUDIO_DATABASE_URL=postgresql://avatar:change_me_local_password@127.0.0.1:15432/avatar_studio

# 2. 首次启动：本机浏览与配置检查，不代表真实成片能力。
AVATAR_STUDIO_MODE=mock
AVATAR_STUDIO_ALLOW_INTEGRATION=0
AVATAR_STUDIO_ALLOW_PRODUCTION=0
AVATAR_STUDIO_ORCHESTRATOR=agents
AVATAR_STUDIO_AGENT_RUNTIME=deepagents
AVATAR_STUDIO_MODEL_BACKEND=deterministic
AVATAR_STUDIO_PUBLISH_ADAPTER=mock
# 不加载原作者电脑上的密钥清单。
AVATAR_STUDIO_SECRETS_FILE=

# 3. 通用媒体预算（单位：人民币分；0 表示未授权）。
# integration 也可能真实收费；内容创作不使用这组金额/次数配额。
# 按使用者预算自行设定，不能用此配置代替供应商限额和页面费用确认。
AVATAR_STUDIO_BUDGET_PER_TASK_FEN=0
AVATAR_STUDIO_BUDGET_DAILY_FEN=0
AVATAR_STUDIO_BUDGET_MAX_SUBMISSIONS=0
AVATAR_STUDIO_WAN_STORYBOARD_BUDGET_UNLIMITED=0

# 4. 文本：各角色共用使用者自己的 OpenAI-compatible URL/key。
# 默认模型名来自当前项目；接收者必须核实自己的渠道支持这些精确 ID。
# URL 按渠道填写。项目兼容基础地址和 /v1 地址，不填网页 Markdown 链接。
AVATAR_STUDIO_OPENAI_BASE_URL=
AVATAR_STUDIO_OPENAI_API_KEY=
AVATAR_STUDIO_CONTENT_WRITER_PROVIDER=openai
AVATAR_STUDIO_CONTENT_WRITER_MODEL=gpt-6.1-sol
AVATAR_STUDIO_CONTENT_WRITER_EXECUTION_MODE=http_api
AVATAR_STUDIO_CONTENT_WRITER_MAX_OUTPUT=16384
AVATAR_STUDIO_CONTENT_WRITER_TIMEOUT_SECONDS=600
AVATAR_STUDIO_CONTENT_PLANNER_PROVIDER=openai
AVATAR_STUDIO_CONTENT_PLANNER_MODEL=gpt-6-astra
AVATAR_STUDIO_CONTENT_PLANNER_TIMEOUT_SECONDS=600
AVATAR_STUDIO_CONTENT_REVIEWER_PROVIDER=openai
AVATAR_STUDIO_CONTENT_REVIEWER_MODEL=gpt-6-astra
AVATAR_STUDIO_CONTENT_REVIEWER_EXECUTION_MODE=http_api
AVATAR_STUDIO_CONTENT_REVIEWER_MAX_OUTPUT=4096
AVATAR_STUDIO_CONTENT_REVIEWER_TIMEOUT_SECONDS=600
# repair 默认跟随 writer。0 关闭自动返工，保留用户定向重写。
AVATAR_STUDIO_CONTENT_MAX_REPAIR_ROUNDS=0
AVATAR_STUDIO_CONTENT_CONCURRENCY=2
# direct 不读取系统代理；需要本机代理时改 system。不会自动换线路重发。
AVATAR_STUDIO_CONTENT_HTTP_PROXY_MODE=direct
AVATAR_STUDIO_CONTENT_GPT_REASONING_EFFORT=medium
AVATAR_STUDIO_CONTENT_MAX_INPUT_TOKENS=0
# USD 成本预留需要人民币汇率与日期；填写实际预算采用值。
AVATAR_STUDIO_FX_USD_CNY=
AVATAR_STUDIO_FX_DATE=
# 可选渠道文本单价：按每百万 token；当前 OpenAI 角色费用仍需对账。
# AVATAR_STUDIO_OPENAI_PRICE_INPUT=
# AVATAR_STUDIO_OPENAI_PRICE_OUTPUT=

# 5. 人物与分镜图片：凭据与文本模型分开。
AVATAR_STUDIO_GPTIMAGE_BASE_URL=
AVATAR_STUDIO_GPTIMAGE_API_KEY=
AVATAR_STUDIO_GPTIMAGE_MODEL=gpt-image-2.5-sunburst

# 6. 百炼：Wan 分镜视频与可选 Qwen3-VL 参考画面分析。
AVATAR_STUDIO_QWEN_API_KEY=
# Wan 必须用自己的百炼工作空间；填写 ID 或下面的完整官方地址。
AVATAR_STUDIO_WAN_WORKSPACE_ID=
AVATAR_STUDIO_WAN_BASE_URL=
AVATAR_STUDIO_CONTENT_VISUAL_PROVIDER=qwen
AVATAR_STUDIO_CONTENT_VISUAL_MODEL=qwen3-vl-plus
AVATAR_STUDIO_CONTENT_VISUAL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
AVATAR_STUDIO_CONTENT_VISUAL_TIMEOUT_SECONDS=600
AVATAR_STUDIO_CONTENT_VISUAL_RESERVE_FEN=80
# 实际单价未核验时保持空，不把未知费用记为 0。
AVATAR_STUDIO_CONTENT_VISUAL_PRICE_FEN=
AVATAR_STUDIO_CONTENT_VISUAL_MAX_BYTES=209715200
AVATAR_STUDIO_CONTENT_VISUAL_MAX_DURATION_MS=600000

# 7. 红狐：参考检索、转写与下载。只查询已受理任务，不重复提交。
AVATAR_STUDIO_REDFOX_API_KEY=
AVATAR_STUDIO_REDFOX_BASE_URL=
AVATAR_STUDIO_REDFOX_RESERVE_FEN_VIDEO_DOWNLOAD=50
AVATAR_STUDIO_REDFOX_PRICE_FEN_VIDEO_DOWNLOAD=
AVATAR_STUDIO_REDFOX_AUTO_POLL_INTERVAL_SECONDS=10
AVATAR_STUDIO_REDFOX_AUTO_POLL_TIMEOUT_SECONDS=600

# 8. MiniMax：仅口播路线需要外部 TTS，分镜 Wan 可生成原声。
AVATAR_STUDIO_MINIMAX_API_KEY=
# 填写实际计费标准（分 / 一万字符）；不提供虚构报价。
AVATAR_STUDIO_MINIMAX_PRICE_FEN_PER_10000_CHARS=

# 9. 本机后期：包含 ffmpeg 与 ffprobe 的 bin 目录；空值时从 PATH 查找。
# Windows 路径建议使用正斜杠，例如 C:/ffmpeg/bin。
AVATAR_STUDIO_FFMPEG_BIN=

# 10. 可选远端 GPU Worker：空值表示尚未配置；启动时用 -SkipGpuTunnel。
# 接通 SSH 隧道后，两项 URL 通常同为 http://127.0.0.1:18080。
AVATAR_STUDIO_M2_WORKER_URL=
AVATAR_STUDIO_M2_WORKER_TOKEN=
AVATAR_STUDIO_ASR_PROVIDER=
AVATAR_STUDIO_ASR_WORKER_URL=
AVATAR_STUDIO_ASR_WORKER_TOKEN=
# ASR_PROVIDER 接真实四阶段 Worker 时填写 qwen3_cloud。
# ASR 未单独填写令牌时沿用 M2 令牌。

# 11. 火山 AK/SK 与 TOS：OmniHuman、当前云端字幕传输需要。
# 桶必须属于使用者；当前上传代码把供应商输入对象设为 public-read。
AVATAR_STUDIO_VOLC_ACCESS_KEY=
AVATAR_STUDIO_VOLC_SECRET_KEY=
AVATAR_STUDIO_TOS_REGION=cn-beijing
AVATAR_STUDIO_TOS_ENDPOINT=
AVATAR_STUDIO_TOS_BUCKET=

# 12. 可选真实抖音发布：安装 requirements-publish.txt 和 Chrome 后，
# 把上面的 PUBLISH_ADAPTER 改为 playwright。登录资料由使用者自己建立。
AVATAR_STUDIO_DOUYIN_BROWSER_CHANNEL=chrome

# Claude Code 为可选旧线路，不是默认部署必需项。
# AVATAR_STUDIO_CLAUDE_CODE_EXECUTABLE=C:/path/to/claude.exe
# AVATAR_STUDIO_CLAUDE_CODE_CONTEXT_1M=true
