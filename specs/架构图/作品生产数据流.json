  "cards": [
    {
      "dot": "cyan",
      "title": "直接生成与内部质检",
      "items": [
        "content 按用户提示生成三稿；不搜索网络、抓取网页或收集热榜。",
        "quality 查询内部历史并核对用户材料/既存已核材料；无依据事实转人工。"
      ]
    },
    {
      "dot": "rose",
      "title": "确定性后期与终审",
      "items": [
        "最终音频确认后，字幕可与两路视频生成并行。",
        "原片审核通过＋字幕就绪 → 代码后期合成/清晰度/封面 → quality 终审。",
        "终审通过后由内部代码打包；两路仍共用固定人物与 MiniMax 声音版本。"
      ]
    },
    {
      "dot": "amber",
      "title": "MVP 范围与待验能力",
      "items": [
        "OmniHuman 为首版必验；当前人物 B、身体动作和分钟级成片待验证。",
        "旧接口建议音频≤15 秒且须<60 秒；用户报价 1 元/秒，尚待账单核验。",
        "V1 到终审通过后的预览下载；不代表平台已发布。"
      ]
    }
  ]
